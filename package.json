{
  "name": "ghibli-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm registry:build && turbo run build",
    "build:web": "pnpm registry:build && pnpm --filter @ghibli/web build",
    "build:storybook": "pnpm --filter @ghibli/web build-storybook",
    "dev": "pnpm registry:build && pnpm --filter @ghibli/web dev",
    "dev:storybook": "pnpm --filter @ghibli/web storybook",
    "lint": "turbo run lint",
    "registry:build": "node -e \"require('node:fs').rmSync('apps/web/public/r',{recursive:true,force:true})\" && shadcn build --output apps/web/public/r",
    "smoke:registry": "node ./scripts/smoke-registry.mjs",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @ghibli/web test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "input-otp": "^1.4.2",
    "lucide-react": "latest",
    "prettier": "latest",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "latest",
    "tailwind-merge": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
