    {
      "name": "style",
      "title": "Ghibli Paper Theme",
      "type": "registry:style",
      "description": "Warm paper theme with stronger ink borders, flatter surfaces, and handcrafted texture helpers.",
      "extends": "none",
      "dependencies": ["tw-animate-css"],
      "files": [],
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-border": "var(--border)",
          "color-ring": "var(--ring)",
          "color-destructive": "var(--destructive)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "font-sans": "var(--font-body)",
          "color-input": "var(--input)"
        },
        "light": {
          "background": "#f7f1e5",
          "foreground": "#4d3b2e",
          "card": "#fcf7ed",
          "card-foreground": "#4d3b2e",
          "popover": "#fffaf2",
          "popover-foreground": "#4d3b2e",
          "paper": "#eece84",
          "paper-soft": "#faf4e8",
          "muted": "#eadfcb",
          "muted-foreground": "#7a6857",
          "primary": "#587855",
          "primary-foreground": "#faf5ea",
          "primary-edge": "#527054",
          "secondary": "#e8dbc0",
          "secondary-foreground": "#554433",
          "accent": "#7fa8bb",
          "accent-foreground": "#28404e",
          "border": "#a16410",
          "border-soft": "#e5d9c8",
          "border-strong": "#a88e70",
          "ring": "#8fb39a",
          "danger": "#ca755d",
          "danger-foreground": "#fff7f1",
          "danger-edge": "#aa5b43",
          "ink-strong": "#33241a",
          "ink-soft": "#7d6552",
          "cloud-surface": "#eef1e7",
          "cloud-ink": "#536152",
          "cloud-border": "#b9c2ae",
          "lantern": "#efbb75",
          "lantern-edge": "#c8883f",
          "meadow-surface": "#dfead6",
          "meadow-ink": "#45563d",
          "meadow-border": "#8ea07d",
          "river-surface": "#d7e7ea",
          "river-ink": "#3d5560",
          "river-border": "#8aa9b6",
          "rose-surface": "#edd8d3",
          "rose-ink": "#6c4942",
          "rose-border": "#b68a83",
          "font-heading": "\"Averia Serif Libre\", Georgia, serif",
          "font-body": "\"M PLUS Rounded 1c\", \"Trebuchet MS\", system-ui, sans-serif",
          "radius": "1rem",
          "shadow-paper": "none",
          "shadow-soft": "none",
          "shadow-raised": "none",
          "texture-paper": "radial-gradient(circle at 1px 1px, rgba(87, 65, 46, 0.06) 1px, transparent 0)",
          "input": "#f1e7d6",
          "destructive": "#ca755d",
          "destructive-foreground": "#fff7f1",
          "destructive-soft-border": "#d8a091",
          "success": "#6f8f5e",
          "theme-dialog-shadow": "none",
          "z-toast": "60",
          "texture-paper-overlay-image": "radial-gradient(circle at 1px 1px, rgba(87, 65, 46, 0.05) 1px, transparent 0)"
        }
      },
      "css": {
        "@import \"tw-animate-css\"": {},
        "@layer base": {
          "*": {
            "box-sizing": "border-box"
          },
          "html": {
            "scroll-behavior": "smooth",
            "background-color": "var(--background)"
          },
          "body": {
            "margin": "0",
            "min-height": "100vh",
            "font-family": "var(--font-body)",
            "color": "var(--foreground)",
            "background-color": "var(--background)"
          },
          "body::before": {
            "position": "fixed",
            "inset": "0",
            "pointer-events": "none",
            "content": "\"\"",
            "opacity": "0.22",
            "background-image": "var(--texture-paper-overlay-image)",
            "background-repeat": "repeat",
            "background-size": "16px 16px"
          },
          "a": {
            "color": "inherit",
            "text-decoration": "none"
          },
          "button,input,textarea,select": {
            "font": "inherit"
          },
          "::selection": {
            "color": "var(--ink-strong)",
            "background": "rgba(239, 187, 117, 0.45)"
          }
        },
        "@layer utilities": {
          ".paper-overlay": {
            "background-image": "var(--texture-paper-overlay-image)",
            "background-repeat": "repeat"
          },
          ".scrollbar-hidden": {
            "-ms-overflow-style": "none",
            "scrollbar-width": "none"
          },
          ".scrollbar-hidden::-webkit-scrollbar": {
            "display": "none",
            "width": "0",
            "height": "0"
          }
        }
      }
    },
